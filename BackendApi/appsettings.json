{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SeedMockData": false,
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=6442;Database=delivery_db;Username=postgres;Maximum Pool Size=100;Timeout=5;CommandTimeout=5;",
    "Redis": "localhost:6389"
  },
  "Minio": {
    "Endpoint": "minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "miniopassword123",
    "BucketName": "delivery-media",
    "UseSsl": false,
    "PublicUrl": "http://localhost:8088/storage/delivery-media"
  },
  "Dispatch": {
    "OfferTimeoutSeconds": 30,
    "HeartbeatTimeoutSeconds": 20,
    "StaleToOfflineSeconds": 120,
    "GpsSyncIntervalSeconds": 30,
    "GpsSyncBatchSize": 30,
    "MaxGpsDriftKm": 5,
    "GpsMinMovementMeters": 5,
    "AckTimeoutSeconds": 3,
    "SearchRadiusKm": 10,
    "GpsChannelCapacity": 0
  },
  "Jwt": {
    "Key": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "Issuer": "DeliveryBackendApi",
    "Audience": "DeliveryClients"
  },
  "Authentication": {
    "SessionLifetimeHours": 24,
    "RequireSecureCookie": true,
    "CookieSameSite": "Lax"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4211",
      "http://127.0.0.1:4211",
      "http://localhost:80",
      "http://localhost:8080",
      "http://localhost:8081",
      "http://localhost:8093",
      "http://127.0.0.1:8093"
    ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowMinutes": 1
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },
  "SecurityHeaders": {
    "Enabled": true
  },
  "Firebase": {
    "ProjectId": "",
    "ServerKey": "",
    "AccessToken": ""
  },
  "AppVersion": {
    "LatestVersion": "1.0.3",
    "BuildNumber": 3,
    "MinSupportedVersion": "1.0.0",
    "ForceUpdate": true
  }
}


