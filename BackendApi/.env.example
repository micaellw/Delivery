ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=replace_with_a_unique_password"
ConnectionStrings__Redis="localhost:6379,password=replace_with_a_unique_password"
ROUTE_OPTIMIZER_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000
ROUTE_OPTIMIZER_API_KEY=change-me
Jwt__Key="replace-with-a-long-random-key-that-is-at-least-32-characters"
Jwt__Issuer=DeliveryBackendApi
Jwt__Audience=DeliveryClients
Cors__AllowedOrigins=http://localhost:4200,http://localhost:80
Authentication__SessionLifetimeHours=24
Authentication__RequireSecureCookie=false
Authentication__CookieSameSite=Lax
SeedAdminPassword=replace_with_a_unique_bootstrap_password_12_chars_minimum
# MinIO Configuration
Minio__Endpoint=minio:9000
Minio__AccessKey=replace_with_minio_access_key
Minio__SecretKey=replace_with_minio_secret_key
Minio__BucketName=delivery-media
Minio__PublicUrl=http://localhost:8088/storage/delivery-media
Minio__UseSsl=false

# Idempotency Retention Policy
IDEMPOTENCY_RETENTION_DAYS=7
